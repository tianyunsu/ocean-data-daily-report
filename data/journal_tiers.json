{
  "schema_version": "1.0",
  "updated": "2026-09-20",
  "policy": {
    "principle": "以期刊质量作为最高优先级；等级参考学会/高校/科研机构期刊目录 + 影响因子；预警期刊降为最低等级并强制标注，供人工取舍。",
    "user_rules": [
      "Science / Nature / PNAS 正刊及子刊 = 最高优先级（S）",
      "MDPI 等被多家科研机构与学术团队列为预警的出版集团 = 最低等级（D），必须标注",
      "SCI(SCIE) / EI 的预警与定期剔除期刊 = 最低等级（D），必须标注（名单见 warning_lists，只按最新一期生效）",
      "预印本若已对应期刊论文（arXiv journal_ref / 已发表 DOI / 同标题期刊记录），按所属期刊等级排序；无期刊版本者独立标记 P，排序低于 S/A 级期刊论文",
      "中文期刊按各学科影响力排名（《中国学术期刊影响因子年报》学科分区 / CNKI 学科排名）分档：学科前 25% → B，其余 → C 并标注",
      "自动评级阈值按学科下调：海洋/地学类期刊 h-index 与两年均被引普遍低于生物医学，阈值采用「h-index 与两年均被引双条件」，避免巨型综合刊指标虚高误判"
    ],
    "tier_order": [
      "S",
      "A",
      "B",
      "C",
      "P",
      "D"
    ],
    "weights": {
      "S": 6,
      "A": 5,
      "B": 4,
      "C": 3,
      "P": 2.5,
      "D": 1,
      "?": 0
    },
    "warning_list_rule": "中科院《国际期刊预警名单》官方说明：不应把多年累积列表合并使用；期刊整改后被移出即不再是预警期刊。本表只按【最新一期】判定，历史名单仅存档。",
    "auto_rating_rule": "A：h≥90 且 两年均被引≥2.5（或 h≥200）；B：h≥35 且 两年均被引≥1.2（或 h≥90 / 两年均被引≥4.0）；C：h≥8 或 两年均被引≥0.5；低于此线仍归 C 并标注「指标偏低」。巨型刊防误判：年发文 >2500 篇的未登记期刊自动降一级并标注。",
    "preprint_rule": "预印本升级判定顺序：① 同 DOI 的期刊记录 → ② 同标题（归一化指纹）的期刊记录 → ③ arXiv journal_ref 解析出刊名。命中即按该刊等级排序，并保留「预印本」标注；均未命中则归 P。目的：预印本是最快的时效渠道，不应因其形态而被降级。"
  },
  "tier_labels": {
    "S": "顶刊（Nature/Science/PNAS 正刊及顶级子刊）",
    "A": "领域权威期刊（学会旗舰刊 / 高影响力子刊）",
    "B": "主流 SCI 期刊",
    "C": "一般期刊 / 新刊 / 开放获取集团刊",
    "P": "预印本（未经同行评审；若已发表/被期刊接受，按该刊等级排序）",
    "D": "预警 / 受限期刊（MDPI 集团刊、中科院与中信所预警、SCI-EI 剔除；仅标注，供取舍）",
    "?": "未登记（待苏老师确认）"
  },
